# ── Application URLs ──
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:8000

# ── Strict PostgreSQL Configuration ──
POSTGRES_USER=kultura
POSTGRES_PASSWORD=kultura
POSTGRES_DB=kultura
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5434
DATABASE_URL=postgresql+asyncpg://kultura:kultura@db:5432/kultura

# ── Paths & Hardware ──
MODELS_DIR=/models
DOCKER_HOST=unix:///var/run/docker.sock
AUTO_UNLOAD_MINUTES=10
GPU_TOTAL_VRAM_MB=4096

# ── Provider Base URLs ──
OLLAMA_BASE_URL=http://ollama:11434
LLAMACPP_BASE_URL=http://llamacpp:8080
KOBOLDCPP_BASE_URL=http://koboldcpp:5001
LMSTUDIO_BASE_URL=http://host.docker.internal:1234
JAN_BASE_URL=http://host.docker.internal:1337

# ── Local Fallback Provider URLs (Host Development) ──
LOCAL_OLLAMA_URL=http://localhost:11434
LOCAL_LLAMACPP_URL=http://localhost:8080
LOCAL_KOBOLDCPP_URL=http://localhost:5001
LOCAL_LMSTUDIO_URL=http://localhost:1234
LOCAL_JAN_URL=http://localhost:1337

# ── Admin & Authentication Credentials ──
ADMIN_ID=omchoksi99@gmail.com
ADMIN_PASS=ucantrustme
JWT_SECRET_KEY=kultura-super-secure-jwt-secret-key-32chars-min-change-in-prod
